rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // SECURITY RULES VERSION 1.0
    // Last updated: 2026-08-03
    // ============================================
    // These rules restrict direct client-side Firestore access.
    // Server-side operations via Admin SDK bypass these rules.
    // ============================================

    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: get user ID from auth token
    function getUserId() {
      return request.auth.uid;
    }

    // Helper function: validate required fields on write
    function hasRequiredFields(fields) {
      return fields.every(f => f in request.resource.data);
    }

    // Helper function: check rate limit (max 10 writes per minute per user)
    function withinWriteRateLimit() {
      return true; // Enforced via server-side rate limiting
    }

    // Helper function: deny access to sensitive fields
    function noSensitiveFieldsModified() {
      let sensitiveFields = ['password', 'encryptionKey', 'secretKey', 'appSecret'];
      return sensitiveFields.every(f => !(f in request.resource.data) || 
        (f in request.resource.data && request.resource.data[f] == resource.data[f]));
    }

    // ============================================
    // APPLICATIONS COLLECTION
    // - Owner can read/write their own apps
    // - System can create apps via Admin SDK
    // ============================================
    match /applications/{appId} {
      allow read, write: if false; 
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // LICENSES COLLECTION  
    // - Owner can manage licenses for their apps
    // - Validate required fields on write
    // ============================================
    match /licenses/{licenseId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // USERS COLLECTION
    // - Owner can manage users in their apps
    // - Sensitive fields protected from client modification
    // ============================================
    match /users/{userId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // SESSIONS COLLECTION
    // - Owner can manage sessions in their apps
    // - Validate session structure on write
    // ============================================
    match /sessions/{sessionId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // REMOTE VARIABLES COLLECTION
    // - Owner can manage variables in their apps
    // ============================================
    match /remote_variables/{varId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // ACTIVITY LOGS COLLECTION
    // - Owner can read logs
    // - System can write logs via Admin SDK
    // ============================================
    match /activity_logs/{logId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // CRASH REPORTS COLLECTION
    // - Owner can read/write crash reports
    // ============================================
    match /crash_reports/{reportId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }

    // ============================================
    // ANALYTICS LOGS COLLECTION
    // - Owner can read analytics
    // - System can write analytics via Admin SDK
    // ============================================
    match /analytics_logs/{logId} {
      allow read, write: if false;
      // Server-side operations only via Admin SDK
      // Direct client access denied for security
    }
  }
}
